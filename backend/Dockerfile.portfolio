# Portfolio-only CPU build: keep one API process to avoid duplicate model loading.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates libgomp1 libglib2.0-0 libgl1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.container.txt ./requirements.container.txt

# Explicit CPU wheel avoids pulling a large CUDA runtime into the portfolio image.
RUN python -m pip install --no-cache-dir "torch==2.9.1" \
        --index-url https://download.pytorch.org/whl/cpu \
    && python -m pip install --no-cache-dir -r requirements.container.txt \
    && python -m pip check

RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin app \
    && mkdir -p /home/app/.cache/huggingface /app/storage/documents \
    && chown -R app:app /home/app /app

COPY --chown=app:app app ./app

USER app
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
