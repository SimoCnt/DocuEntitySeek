APP_NAME=DocuEntitySeek API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

API_V1_PREFIX=/api/v1

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

DB_HOST=localhost
DB_PORT=5432
DB_NAME=docuentityseek
DB_USER=docuentityseek_app
DB_PASSWORD=

SQL_ECHO=false

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=docuentityseek-api
JWT_AUDIENCE=docuentityseek-web

APP_LOG_LEVEL=INFO

DOCUMENT_STORAGE_ROOT=storage/documents

PDF_TEXT_SORT=false

# AI execution environment
AI_MODEL_DEVICE=auto
AI_MODEL_QUANTIZE=false
AI_MODEL_COMPILE=false

# PDF originals: local (default) or s3. Do not expose S3 credentials in the React frontend.
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_S3_ENDPOINT_URL=http://127.0.0.1:9000
DOCUMENT_S3_BUCKET=docuentityseek-documents
DOCUMENT_S3_REGION=us-east-1
DOCUMENT_S3_ACCESS_KEY=
DOCUMENT_S3_SECRET_KEY=
