FROM node:24-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci
COPY . .

# Vite variables are compiled into the static frontend at build time.
ARG VITE_API_BASE_URL=/api/v1
ARG VITE_PREMIUM_CONTACT_EMAIL=
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_PREMIUM_CONTACT_EMAIL=${VITE_PREMIUM_CONTACT_EMAIL}
RUN npm run build

FROM nginx:stable-alpine
COPY nginx.portfolio.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
